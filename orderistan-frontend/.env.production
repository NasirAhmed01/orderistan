# ALL URLs / addresses of the frontend are set here (or as Cloudflare build variables with the same names). Nothing is hardcoded in the code.
# Backend URL: leave EMPTY when frontend + backend run in the same Cloudflare Worker (same origin, /api). Set a full URL only for a separate backend.
VITE_API_URL=
# Main domain; seller stores live at <slug>.<this domain>
VITE_ROOT_DOMAIN=orderistan.site
# Public support e-mail shown in the footer / contact / legal pages
VITE_SUPPORT_EMAIL=orderistan@gmail.com
