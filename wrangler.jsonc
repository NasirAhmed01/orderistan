{
  // Orderistan on Cloudflare Workers FREE plan: frontend (Static Assets) + API (Express inside a Durable Object) in ONE Worker.
  // No Containers, no Docker. Deploy:  npx wrangler deploy   (it builds the frontend first, see "build")
  "name": "orderistan",
  "main": "orderistan-backend/worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_server_modules"],
  "workers_dev": true,
  "keep_vars": true,
  "build": { "command": "npm run build" },

  // Static files are served by Cloudflare WITHOUT running the Worker (they do not count against the 100,000 requests/day).
  // Only /api/* runs the Worker code.
  "assets": {
    "directory": "./orderistan-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // The API lives in one SQLite-backed Durable Object (available on the Free plan). It keeps the MongoDB Atlas connection warm.
  "durable_objects": { "bindings": [{ "name": "API", "class_name": "ApiServer" }] },
  "exports": { "ApiServer": { "type": "durable-object", "storage": "sqlite" } },

  // Replaces the old Vercel cron + setInterval jobs. Free plan allows 5 Cron Triggers per ACCOUNT in total, so only 1 is used (hourly/daily jobs are derived in worker.mjs).
  "triggers": { "crons": ["*/10 * * * *"] },

  // Non-secret settings (secrets are set with `wrangler secret put`, see CLOUDFLARE_DEPLOY.md). Edit ROOT_DOMAIN / ALLOWED_ORIGINS here.
  "vars": {
    "NODE_ENV": "production",
    "ROOT_DOMAIN": "orderistan.site",
    "SUPPORT_EMAIL": "orderistan@gmail.com",
    "ALLOWED_ORIGINS": "https://orderistan.orderistan.workers.dev",
    "TRUST_PROXY": "1",
    "JWT_EXPIRES_IN": "7d",
    "ADMIN_JWT_EXPIRES_IN": "2h",
    "TRIAL_DAYS": "0",
    "BREVO_SENDER_NAME": "Orderistan"
  },

  // Custom domain (after orderistan.site is on this Cloudflare account) - uncomment, deploy again:
  // "routes": [
  //   { "pattern": "orderistan.site", "custom_domain": true },
  //   { "pattern": "www.orderistan.site", "custom_domain": true },
  //   { "pattern": "*.orderistan.site/*", "zone_name": "orderistan.site" }   // seller stores (+ proxied wildcard DNS record "*")
  // ],
  "observability": { "enabled": true }
}
